{
  "name": "plailist",
  "version": "1.0.0",
  "description": "AI-Powered Spotify Playlist Manager - Dynamic playlist generation and management",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "electron . --dev",
    "build": "vite build",
    "build:electron": "electron-builder",
    "preview": "vite preview",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "electron",
    "spotify",
    "ai",
    "playlist",
    "music"
  ],
  "author": "Kyle",
  "license": "ISC",
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "concurrently": "^9.1.2",
    "electron": "^36.3.1",
    "electron-builder": "^26.0.12",
    "svelte": "^5.33.2",
    "vite": "^6.3.5",
    "vite-plugin-electron": "^0.29.0"
  },
  "dependencies": {
    "axios": "^1.9.0",
    "bootstrap": "^5.3.6",
    "bootstrap-icons": "^1.13.1",
    "dotenv": "^16.5.0"
  }
}
